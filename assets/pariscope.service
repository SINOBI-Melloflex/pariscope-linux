[Unit]
Description=Pariscope Network Monitor (Velocity Tech)
After=network-online.target
Wants=network-online.target

[Service]
User=pariscope
WorkingDirectory=/opt/pariscope/app
Environment=PARISCOPE_DATA=/var/lib/pariscope
ExecStart=/usr/bin/node app.js
AmbientCapabilities=CAP_NET_RAW
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target