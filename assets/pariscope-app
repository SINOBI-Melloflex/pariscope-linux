#!/usr/bin/env bash
URL="http://localhost:4000"

# service bondho thakle chalu koro
if ! systemctl is-active --quiet pariscope; then
  systemctl start pariscope 2>/dev/null || pkexec systemctl start pariscope 2>/dev/null || true
fi

# server ready howa porjonto max 40 sec opekkha
for _ in $(seq 1 40); do
  curl -fs -o /dev/null "$URL" && break
  sleep 1
done

# Chromium-based browser thakle alada app window
for b in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge microsoft-edge-stable brave-browser; do
  if command -v "$b" >/dev/null 2>&1; then
    exec "$b" --app="$URL" --class=Pariscope --user-data-dir="$HOME/.config/pariscope-app" --no-first-run --no-default-browser-check
  fi
done

# na thakle normal browser
exec xdg-open "$URL"